---
import { site } from '../data/site';
import '../styles/global.css';

const canonical = new URL('/', Astro.site ?? new URL('https://7harshitsingh.github.io')).href;
const pageTitle = 'Harshit(7harshitsingh) - Applied AI Engineer';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/misans@4.1.0/lib/Normal/MiSans-Medium.min.css" />
    <link rel="icon" type="image/jpeg" href="/pfp.jpg" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={site.description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="home-main"><slot /></main>
  </body>
</html>
