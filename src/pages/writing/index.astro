---
import Layout from '../../layouts/Layout.astro';
import { getPublishedWriting } from '../../lib/writing';
const posts = await getPublishedWriting();
const dateLabel = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' });
---
<Layout title="Writing" description="Articles by Harshit Singh.">
  <section class="writing-index" aria-labelledby="writing-heading">
    <h1 id="writing-heading">Writing</h1>
    {posts.length === 0 ? (
      <p class="empty-state">No articles published yet.</p>
    ) : (
      <ol class="post-list">
        {posts.map((post) => (
          <li>
            <article>
              <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateLabel.format(post.data.date)}</time>
            </article>
          </li>
        ))}
      </ol>
    )}
  </section>
</Layout>
