---
import type { Experience } from '../../data/site';
interface Props { experience: Experience[] }
const { experience } = Astro.props;
---
<section class="panel experience-panel" aria-labelledby="experience-heading">
  <h2 id="experience-heading">Experience</h2>
  <ol>
    {experience.map((item) => (
      <li>
        <strong>{item.role}</strong>
        <span>{item.organization} · {item.period}</span>
        {item.summary && <p>{item.summary}</p>}
      </li>
    ))}
  </ol>
</section>
