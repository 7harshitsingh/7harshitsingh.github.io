---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/home/ProjectGrid.astro';
import ExperienceList from '../components/home/ExperienceList.astro';
import LocalTime from '../components/home/LocalTime.astro';
import WritingCard from '../components/home/WritingCard.astro';
import { site } from '../data/site';
import { getPublishedWriting } from '../lib/writing';

const posts = await getPublishedWriting();
---

<Layout>
  <div class="home-grid">
    <div class="home-content">
      <section class="card profile-card" aria-labelledby="intro-heading">
        <span class="avatar"><img src="/avatar.jpg" alt="" width="72" height="72" /></span>
        <div>
          <p class="eyebrow">Hello, I'm</p>
          <h1 id="intro-heading">{site.name}</h1>
          <p>Applied AI engineer</p>
        </div>
      </section>

      <section class="card about-card" aria-labelledby="about-heading">
        <h2 id="about-heading">🧑‍💻 About Me</h2>
        <p>{site.intro}</p>
        <p class="about-meta">AI Platforms Engineer · L&amp;T Finance</p>
      </section>

      <LocalTime />

      <section class="card featured-card" aria-labelledby="featured-heading">
        <p class="eyebrow">Featured project</p>
        <h2 id="featured-heading"><a href={site.projects[0].href}>doc-qa ↗</a></h2>
        <p>{site.projects[0].summary}</p>
        <ul class="tag-list">{site.projects[0].tools.map((tool) => <li>{tool}</li>)}</ul>
      </section>

      <ProjectGrid projects={site.projects.slice(1)} />
      <ExperienceList experience={site.experience} />

      <section class="card skills-card" aria-labelledby="skills-heading">
        <h2 id="skills-heading">⚡ Skills</h2>
        <ul class="tag-list">{site.skills.map((skill) => <li>{skill}</li>)}</ul>
      </section>

      <section class="card education-card" aria-labelledby="education-heading">
        <h2 id="education-heading">🎓 Education</h2>
        <strong>IIT Delhi</strong>
        <p>{site.education.degree}<br />{site.education.year}</p>
      </section>

      <section class="card links-card" aria-labelledby="links-heading">
        <h2 id="links-heading">🔗 Elsewhere</h2>
        <ul class="profile-links">
          {site.links.map((link) => (
            <li><a href={link.href} rel="me" aria-label={link.label} title={link.label}>
              {link.label === 'GitHub' ? <img src="/icons/mark-github.svg" alt="" width="24" height="24" /> : link.label === 'LinkedIn' ? <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.96V9.2h2.97v9.55ZM6.45 7.9a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44Zm12.3 10.85h-2.97V14.1c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.73H9.5V9.2h2.85v1.3h.04c.4-.75 1.37-1.54 2.82-1.54 3.01 0 3.57 1.98 3.57 4.55v5.24Z"/></svg> : <span class="hf-icon" aria-hidden="true">🤗</span>}
            </a></li>
          ))}
          <li><a class="cv-link" href="/Harshit_Singh_IITD_LTFS_AI_Engineer.pdf" download="Harshit_Singh_CV.pdf" aria-label="Download CV" title="Download CV">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
            <span>CV</span>
          </a></li>
        </ul>
        <span class="copyright">© {new Date().getFullYear()} {site.name}</span>
      </section>
    </div>

    <WritingCard posts={posts} />
  </div>
</Layout>
